enum AnalysisJobType {
  ANALYSIS
  ENGINE_ANALYSIS
  REPORT_GENERATION
  HOMEWORK_GENERATION
  PROGRESS_GENERATION
}

enum AnalysisJobStatus {
  PENDING
  RUNNING
  PARSING
  EXTRACTING_ANNOTATIONS
  CLASSIFICATION
  GENERATING_OUTPUT
  COMPLETED
  FAILED
}

enum ReportAudience {
  COACH
  PARENT
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum WeaknessTag {
  MISSED_FORK                  @map("missed_fork")
  MISSED_PIN                   @map("missed_pin")
  MISSED_DOUBLE_ATTACK         @map("missed_double_attack")
  MISSED_DISCOVERED_ATTACK     @map("missed_discovered_attack")
  MISSED_MATE                  @map("missed_mate")
  ALLOWED_MATE                 @map("allowed_mate")
  HANGING_PIECE                @map("hanging_piece")
  MISSED_CAPTURE               @map("missed_capture")
  BAD_CAPTURE                  @map("bad_capture")
  MISSED_OPPONENT_THREAT       @map("missed_opponent_threat")
  OPENED_LINE                  @map("opened_line")
  UNKNOWN_TACTICAL_ERROR       @map("unknown_tactical_error")
  KING_SAFETY                  @map("king_safety")
  DELAYED_CASTLING             @map("delayed_castling")
  POOR_DEVELOPMENT             @map("poor_development")
  EARLY_QUEEN                  @map("early_queen")
  BAD_TRADE                    @map("bad_trade")
  POOR_CONVERSION              @map("poor_conversion")
  OPENING_STRATEGY             @map("opening_strategy")
  PAWN_STRUCTURE               @map("pawn_structure")
  ENDGAME_TECHNIQUE            @map("endgame_technique")
  UNKNOWN_STRATEGIC_ERROR      @map("unknown_strategic_error")
  TIME_MANAGEMENT              @map("time_management")
  CALCULATION_DEPTH            @map("calculation_depth")
  TUNNEL_VISION                @map("tunnel_vision")
  MATERIAL_GREED               @map("material_greed")
  LOW_BOARD_AWARENESS          @map("low_board_awareness")
  INSUFFICIENT_ANNOTATION_DATA @map("insufficient-annotation-data")
  REDUCED_CONFIDENCE           @map("reduced-confidence")
}

enum GameResult {
  WIN
  LOSS
  DRAW
  UNKNOWN
}

enum MomentSeverity {
  INACCURACY
  MISTAKE
  BLUNDER
  MATE
  UNKNOWN
}

enum MoveColor {
  WHITE
  BLACK
}

enum MistakeReviewStatus {
  UNREVIEWED
  CONFIRMED
  REJECTED
}

model AnalysisJob {
  id               String             @id @default(uuid())
  traceId          String             @default(uuid())
  coachAccountId   String
  studentId        String
  gameId           String
  jobType          AnalysisJobType
  sourceAnalysisId String?
  reportAudience   ReportAudience?
  status           AnalysisJobStatus  @default(PENDING)
  queueName        String
  attemptCount     Int                @default(0)
  maxAttempts      Int                @default(3)
  progressPercent  Int?
  failureCode      String?
  failureMessage   String?
  startedAt        DateTime?
  completedAt      DateTime?
  lastRetriedAt    DateTime?
  coachAccount     CoachAccount       @relation(fields: [coachAccountId], references: [id], onDelete: Cascade)
  student          Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game             Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)
  analysis         GameAnalysis?
  events           AnalysisJobEvent[]
  generationTraces GenerationTrace[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([traceId])
  @@index([coachAccountId])
  @@index([studentId])
  @@index([gameId])
  @@index([gameId, createdAt])
  @@index([studentId, createdAt])
}

model AnalysisJobEvent {
  id            String       @id @default(uuid())
  analysisJobId String?
  traceId       String
  stage         String
  level         String
  message       String
  payload       Json?
  analysisJob   AnalysisJob? @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([analysisJobId])
  @@index([traceId])
  @@index([analysisJobId, createdAt])
  @@index([traceId, createdAt])
}

model GameAnalysis {
  id                     String            @id @default(uuid())
  coachAccountId         String
  studentId              String
  gameId                 String
  analysisJobId          String            @unique
  resultVersion          Int               @default(1)
  confidenceLevel        ConfidenceLevel
  overallDiagnosis       String
  openingName            String?
  result                 GameResult        @default(UNKNOWN)
  mainWeaknessTag        WeaknessTag?
  secondaryWeaknessTags  WeaknessTag[]     @default([])
  recommendedLessonTitle String?
  recommendedLessonWhy   String?
  recommendedFocusPoints Json
  rawExtractedContext    Json
  rawAnalysisJson        Json
  coachAccount           CoachAccount      @relation(fields: [coachAccountId], references: [id], onDelete: Cascade)
  student                Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game                   Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  analysisJob            AnalysisJob       @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  criticalMoments        CriticalMoment[]
  mistakes               Mistake[]
  reports                Report[]
  reportRevisions        ReportRevision[]
  homeworks              Homework[]
  generationTraces       GenerationTrace[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([coachAccountId])
  @@index([studentId])
  @@index([gameId])
  @@index([studentId, createdAt])
}

model CriticalMoment {
  id               String         @id @default(uuid())
  analysisId       String
  ply              Int
  fullMoveNumber   Int
  moveNumber       String
  moveColor        MoveColor
  san              String
  lan              String?
  uci              String?
  beforeFen        String
  afterFen         String
  bestMove         String?
  bestVariation    Json
  nags             Json
  comments         Json
  evaluationBefore Json?
  evaluationAfter  Json?
  severity         MomentSeverity @default(UNKNOWN)
  sourceEvidence   Json
  analysis         GameAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  mistakes         Mistake[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([analysisId])
  @@index([analysisId, ply])
}

model Mistake {
  id               String              @id @default(uuid())
  analysisId       String
  criticalMomentId String?
  severity         MomentSeverity      @default(UNKNOWN)
  reviewStatus     MistakeReviewStatus @default(UNREVIEWED)
  coachNote        String?
  category         String
  mainTag          WeaknessTag?
  secondaryTags    WeaknessTag[]       @default([])
  explanation      String
  suggestedFix     String?
  sourceEvidence   Json
  analysis         GameAnalysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  criticalMoment   CriticalMoment?     @relation(fields: [criticalMomentId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([analysisId])
  @@index([criticalMomentId])
}

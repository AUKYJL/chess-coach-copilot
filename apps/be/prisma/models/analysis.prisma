enum AnalysisJobType {
  ANALYSIS
  REPORT_GENERATION
  HOMEWORK_GENERATION
  PROGRESS_GENERATION
}

enum AnalysisJobStatus {
  PENDING
  PARSING
  EXTRACTING_ANNOTATIONS
  CLASSIFICATION
  REPORT_GENERATION
  COMPLETED
  FAILED
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum GameResult {
  WIN
  LOSS
  DRAW
  UNKNOWN
}

enum MomentSeverity {
  INACCURACY
  MISTAKE
  BLUNDER
  MATE
  UNKNOWN
}

enum MoveColor {
  WHITE
  BLACK
}

model AnalysisJob {
  id               String            @id @default(uuid())
  coachAccountId   String
  studentId        String
  gameId           String
  jobType          AnalysisJobType
  status           AnalysisJobStatus @default(PENDING)
  queueName        String
  attemptCount     Int               @default(0)
  maxAttempts      Int               @default(3)
  progressPercent  Int?
  failureCode      String?
  failureMessage   String?
  startedAt        DateTime?
  completedAt      DateTime?
  lastRetriedAt    DateTime?
  coachAccount     CoachAccount      @relation(fields: [coachAccountId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game             Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  analysis         GameAnalysis?
  generationTraces GenerationTrace[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([coachAccountId])
  @@index([studentId])
  @@index([gameId])
}

model GameAnalysis {
  id                     String            @id @default(uuid())
  coachAccountId         String
  studentId              String
  gameId                 String
  analysisJobId          String            @unique
  resultVersion          Int               @default(1)
  confidenceLevel        ConfidenceLevel
  overallDiagnosis       String
  openingName            String?
  result                 GameResult        @default(UNKNOWN)
  mainWeaknessTag        String?
  secondaryWeaknessTags  Json
  recommendedLessonTitle String?
  recommendedLessonWhy   String?
  recommendedFocusPoints Json
  rawExtractedContext    Json
  rawAnalysisJson        Json
  coachAccount           CoachAccount      @relation(fields: [coachAccountId], references: [id], onDelete: Cascade)
  student                Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game                   Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  analysisJob            AnalysisJob       @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  criticalMoments        CriticalMoment[]
  mistakes               Mistake[]
  reports                Report[]
  homeworks              Homework[]
  generationTraces       GenerationTrace[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([coachAccountId])
  @@index([studentId])
  @@index([gameId])
}

model CriticalMoment {
  id               String         @id @default(uuid())
  analysisId       String
  ply              Int
  fullMoveNumber   Int
  moveNumber       String
  moveColor        MoveColor
  san              String
  lan              String?
  uci              String?
  beforeFen        String
  afterFen         String
  bestMove         String?
  bestVariation    Json
  nags             Json
  comments         Json
  evaluationBefore Json?
  evaluationAfter  Json?
  severity         MomentSeverity @default(UNKNOWN)
  sourceEvidence   Json
  analysis         GameAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  mistakes         Mistake[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([analysisId])
  @@index([analysisId, ply])
}

model Mistake {
  id               String          @id @default(uuid())
  analysisId       String
  criticalMomentId String?
  severity         MomentSeverity  @default(UNKNOWN)
  category         String
  explanation      String
  suggestedFix     String?
  sourceEvidence   Json
  analysis         GameAnalysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  criticalMoment   CriticalMoment? @relation(fields: [criticalMomentId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([analysisId])
  @@index([criticalMomentId])
}

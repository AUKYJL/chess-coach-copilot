enum AnalysisJobType {
  ANALYSIS
  REPORT_GENERATION
  HOMEWORK_GENERATION
  PROGRESS_GENERATION
}

enum AnalysisJobStatus {
  PENDING
  PARSING
  EXTRACTING_ANNOTATIONS
  CLASSIFICATION
  REPORT_GENERATION
  COMPLETED
  FAILED
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum GameResult {
  WIN
  LOSS
  DRAW
  UNKNOWN
}

enum MomentSeverity {
  INACCURACY
  MISTAKE
  BLUNDER
  MATE
  UNKNOWN
}

model AnalysisJob {
  id               String            @id @default(uuid())
  coachAccountId   String
  studentId        String
  gameId           String
  jobType          AnalysisJobType
  status           AnalysisJobStatus @default(PENDING)
  queueName        String
  attemptCount     Int               @default(0)
  maxAttempts      Int               @default(3)
  progressPercent  Int?
  failureCode      String?
  failureMessage   String?
  startedAt        DateTime?
  completedAt      DateTime?
  lastRetriedAt    DateTime?
  coachAccount     CoachAccount      @relation(fields: [coachAccountId], references: [id], onDelete: Cascade)
  student          Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game             Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  analysis         GameAnalysis?
  generationTraces GenerationTrace[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([coachAccountId])
  @@index([studentId])
  @@index([gameId])
}

model GameAnalysis {
  id                     String            @id @default(uuid())
  coachAccountId         String
  studentId              String
  gameId                 String
  analysisJobId          String            @unique
  resultVersion          Int               @default(1)
  confidenceLevel        ConfidenceLevel
  overallDiagnosis       String
  openingName            String?
  result                 GameResult        @default(UNKNOWN)
  mainWeaknessTag        String?
  secondaryWeaknessTags  Json
  recommendedLessonTitle String?
  recommendedLessonWhy   String?
  recommendedFocusPoints Json
  rawExtractedContext    Json
  rawAnalysisJson        Json
  coachAccount           CoachAccount      @relation(fields: [coachAccountId], references: [id], onDelete: Cascade)
  student                Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  game                   Game              @relation(fields: [gameId], references: [id], onDelete: Cascade)
  analysisJob            AnalysisJob       @relation(fields: [analysisJobId], references: [id], onDelete: Cascade)
  criticalMoments        CriticalMoment[]
  mistakes               Mistake[]
  reports                Report[]
  homeworks              Homework[]
  generationTraces       GenerationTrace[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([coachAccountId])
  @@index([studentId])
  @@index([gameId])
}

model CriticalMoment {
  id                 String         @id @default(uuid())
  analysisId         String
  moveNumber         String
  movePlayed         String
  bestMove           String?
  fen                String?
  evaluationBefore   String?
  evaluationAfter    String?
  evalChange         String?
  severity           MomentSeverity @default(UNKNOWN)
  mainTag            String
  secondaryTags      Json
  confidence         Decimal        @db.Decimal(5, 4)
  whatHappened       String
  studentExplanation String
  coachNote          String
  trainingTheme      String?
  sourceEvidence     Json
  analysis           GameAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([analysisId])
}

model Mistake {
  id             String         @id @default(uuid())
  analysisId     String
  moveNumber     String
  movePlayed     String
  bestMove       String?
  severity       MomentSeverity @default(UNKNOWN)
  category       String
  explanation    String
  suggestedFix   String?
  sourceEvidence Json
  analysis       GameAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([analysisId])
}

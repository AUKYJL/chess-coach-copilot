enum GameSourceType {
  MANUAL_PGN
  LICHESS_IMPORT
}

enum StudentColor {
  WHITE
  BLACK
}

enum AnnotationCoverage {
  FULL
  PARTIAL
  NONE
}

enum EngineEvidenceStatus {
  READY
  QUEUED
  RUNNING
  FAILED
}

enum EngineEvidenceSource {
  PGN
  STOCKFISH
}

model Game {
  id                       String             @id @default(uuid())
  coachAccountId           String
  studentId                String
  sourceType               GameSourceType
  sourceLabel              String?
  studentColor             StudentColor
  event                    String?
  site                     String?
  whitePlayerName          String?
  blackPlayerName          String?
  openingHeader            String?
  ecoCode                  String?
  rawResult                String?
  derivedResult            GameResult         @default(UNKNOWN)
  plyCount                 Int?
  rawPgn                   String
  normalizedPgnHash        String
  hasEngineAnnotations     Boolean            @default(false)
  annotationCoverage       AnnotationCoverage @default(NONE)
  reducedConfidenceWarning String?
  engineEvidence           Json?
  engineEvidenceStatus     EngineEvidenceStatus?
  engineEvidenceSource     EngineEvidenceSource?
  importedAt               DateTime           @default(now())
  coachAccount             CoachAccount       @relation(fields: [coachAccountId], references: [id], onDelete: Cascade)
  student                  Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  analysisJobs             AnalysisJob[]
  analyses                 GameAnalysis[]
  reports                  Report[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([coachAccountId])
  @@index([studentId])
  @@index([studentId, importedAt])
  @@index([studentId, importedAt, createdAt])
  @@index([studentId, normalizedPgnHash])
}
